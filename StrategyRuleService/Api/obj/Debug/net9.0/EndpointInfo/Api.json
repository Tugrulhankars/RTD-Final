  "components": {
    "schemas": {
      "CreateStrategyCommand": {
        "required": [
          "stockSymbol",
          "strategyName"
        ],
        "type": "object",
        "properties": {
          "strategyName": {
            "maxLength": 100,
            "minLength": 3,
            "type": "string"
          },
          "description": {
            "maxLength": 500,
            "minLength": 0,
            "type": "string",
            "nullable": true
          },
          "userId": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "stockSymbol": {
            "maxLength": 10,
            "minLength": 2,
            "type": "string"
          },
          "timeTracking": {
            "maximum": 1440,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "totalPercentLoss": {
            "maximum": 100,
            "minimum": 0,1,
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "lot": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "transactionAmount": {
            "minimum": 0,
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "accountId": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "portfolioId": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "durationHours": {
            "minimum": 0,0167,
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "stopLossPercentage": {
            "maximum": 20,
            "minimum": 0,1,
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "takeProfitPercentage": {
            "maximum": 50,
            "minimum": 0,1,
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "entryThresholdPercentage": {
            "maximum": 0,
            "minimum": -50,
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "maxLossLimitPercentage": {
            "maximum": 100,
            "minimum": 0,1,
            "type": "number",
            "format": "double",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "StopStrategyCommand": {
        "type": "object",
        "properties": {
          "strategyId": {
            "type": "integer",
            "format": "int32"
          },
          "userId": {
            "type": "integer",
            "format": "int32"
          },
          "reason": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "UpdateStrategyPreferencesCommand": {
        "required": [
          "ticker"
        ],
        "type": "object",
        "properties": {
          "strategyId": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "userId": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "ticker": {
            "minLength": 1,
            "type": "string"
          },
          "stopLossPercentage": {
            "maximum": 20,
            "minimum": 0,1,
            "type": "number",
            "format": "double"
          },
          "takeProfitPercentage": {
            "maximum": 50,
            "minimum": 0,1,
            "type": "number",
            "format": "double"
          },
          "entryThresholdPercentage": {
            "maximum": 0,
            "minimum": -50,
            "type": "number",
            "format": "double"
          },
          "maxLossLimitPercentage": {
            "maximum": 100,
            "minimum": 0,1,
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      }
    }
